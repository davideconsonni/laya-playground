# The build context must not include the local environment nor the weights: they are GB.
.venv/
.hf-cache/
__pycache__/
*.pyc

# Secrets: the token enters at runtime with `env_file`/`--env-file`, never into the image.
.env

# Windows stuff, launchers and files the image does not use.
run.ps1
run.bat
run.sh
.python-version
uv.lock
*.md
