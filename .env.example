# Copy this file to `.env` and fill in the values.

# Hugging Face token.
# NOT required: the convaiinnovations/laya* checkpoints are public (Apache-2.0).
# It is only needed for higher rate limits or for private/fine-tuned checkpoints of your own.
# Create one at https://huggingface.co/settings/tokens (read is enough).
HF_TOKEN=

# Where to keep the downloaded weights, relative to the project root.
LAYA_HF_CACHE=.hf-cache

# Where the server listens.
LAYA_HOST=127.0.0.1
LAYA_PORT=8000

# Default device of the server: cuda | cpu | mps | xpu | auto
LAYA_DEVICE=cuda

# Key that protects the /api/* routes. Empty = no protection (local use).
# SET IT if you publish the service on the internet.
LAYA_API_KEY=

# Cap on the torch threads for CPU inference. If you do not set it, the server derives it from
# the container CPU limit (cgroup) or from the host cores, with a cap at 16 (the maximum measured
# in the laya README). In a container on a big machine it is worth setting it.
# LAYA_THREADS=8
