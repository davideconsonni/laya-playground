# Copia questo file in `.env` e compila i valori.

# Token Hugging Face.
# NON e' obbligatorio: i checkpoint convaiinnovations/laya* sono pubblici (Apache-2.0).
# Serve solo per rate limit piu' alti o per checkpoint privati/fine-tuned tuoi.
# Crealo su https://huggingface.co/settings/tokens (read e' sufficiente).
HF_TOKEN=

# Dove tenere i pesi scaricati, relativo alla radice del progetto.
LAYA_HF_CACHE=.hf-cache

# Dove ascolta il server.
LAYA_HOST=127.0.0.1
LAYA_PORT=8000

# Device di default del server: cuda | cpu | mps | xpu | auto
LAYA_DEVICE=cuda

# Chiave che protegge le rotte /api/*. Vuota = nessuna protezione (uso locale).
# IMPOSTALA se pubblichi il servizio su internet.
LAYA_API_KEY=

# Tetto ai thread di torch per l'inferenza su CPU. Se non la imposti il server la ricava dal
# limite di CPU del container (cgroup) o dai core dell'host, con tetto a 16 (il massimo
# misurato nel README di laya). In un container su una macchina grossa conviene impostarla.
# LAYA_THREADS=8
